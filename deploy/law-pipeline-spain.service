[Unit]
Description=Spain legislative procedure map
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/law-pipeline-spain/current
ExecStart=/usr/bin/docker compose up --detach --no-build --pull never
ExecStop=/usr/bin/docker compose down
Restart=no
TimeoutStartSec=60
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
